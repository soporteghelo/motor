# Copia este archivo a .env para probar `npm run build` en local.
# En Vercel se cargan en Settings → Environment Variables (no se sube .env).

# ── BASE DE DATOS DE ESTE DESPLIEGUE ──────────────────────────────────────
#   supabase  → Supabase (Postgres + Storage + Auth)
#   appscript → Google Sheets + Drive vía Apps Script (00_Config/Code.gs)
# Vacío = el valor de DB_PROVIDER en 00_Config/Global_Config.js.html
DB_PROVIDER=supabase

# ── SUPABASE (si DB_PROVIDER=supabase) ────────────────────────────────────
# Públicas: van al navegador (la anon key es segura porque RLS está activo)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key: Supabase → Settings → API → anon public>
# SECRETA: solo la usa api/usuarios.js en el servidor. Nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=<service_role key: Supabase → Settings → API>

# ── APPS SCRIPT (si DB_PROVIDER=appscript) ────────────────────────────────
# URL /exec de la implementación "Aplicación web" de Code.gs
# (Implementar → Gestionar implementaciones). Acceso: "Cualquier persona".
APPS_SCRIPT_URL=https://script.google.com/macros/s/<id-de-implementación>/exec

# Opcional: versión mostrada en el pie de página
APP_VERSION=1.5.0

# ── APP INSTALABLE: ACTUALIZACIÓN POR AIRE (OTA) ──────────────────────────
# `npm run ota:publish` sube el bundle al bucket "actualizaciones" con la
# SUPABASE_SERVICE_ROLE_KEY de arriba. Subir código que se ejecutará en los
# teléfonos no puede hacerse con la anon key, así que esa clave es
# obligatoria para publicar (y solo vive aquí o en el CI, nunca en el build).
#
# Opcional: solo si alojas los bundles fuera de Supabase Storage. Vacío = se
# deduce de SUPABASE_URL (o de Global_Config.js.html si no hay .env).
# OTA_URL=https://<project-ref>.supabase.co/storage/v1/object/public/actualizaciones
